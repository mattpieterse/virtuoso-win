<!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
<u:ContentDialog
    x:Name="ContentDialog"
    x:Class = "Virtuoso.UI.Views.Decks.Dialogs.InsertContentDialog"
    xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c = "http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d = "http://schemas.microsoft.com/expression/blend/2008"
    xmlns:u = "http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l = "clr-namespace:Virtuoso.UI.Views.Decks.Dialogs"
    xmlns:p = "clr-namespace:Virtuoso.UI.Views.Decks.Components"
    c:Ignorable = "d"
    u:Title = "Create a new deck"
    u:PrimaryButtonText = "Create"
    u:CloseButtonIcon = "{u:SymbolIcon Symbol=Dismiss24}"
    u:CloseButtonText = "Cancel">
    <u:ContentDialog.Resources>
        <Style
            BasedOn = "{StaticResource {x:Type u:ContentDialog}}"
            TargetType = "{x:Type l:InsertContentDialog}" />

    </u:ContentDialog.Resources>

    <!-- UI -->

    <u:ContentDialog.Content>
        <Grid
            x:Name="ContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height = "Auto" />
                <RowDefinition
                    Height = "6" />
                <RowDefinition
                    Height = "*" />
            </Grid.RowDefinitions>

            <StackPanel
                Orientation = "Vertical"
                Grid.Row = "0">
                <Label
                    Content = "Title"
                    Target = "{Binding ElementName=NameInput}" />
                <u:TextBox
                    x:Name = "NameInput"
                    PlaceholderText = "Default"
                    MaxLines = "1" />

            </StackPanel>

            <u:CardControl
                Grid.Row = "2">
                <u:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width = "1*" />
                            <ColumnDefinition
                                Width = "12" />
                            <ColumnDefinition
                                Width = "2*" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Grid.Column = "0">
                            <Grid.RowDefinitions>
                                <RowDefinition
                                    Height = "Auto" />
                                <RowDefinition
                                    Height = "12" />
                                <RowDefinition
                                    Height = "Auto" />
                                <RowDefinition
                                    Height = "*" />
                            </Grid.RowDefinitions>

                            <u:NumberBox
                                Grid.Row = "0"
                                x:Name = "GridSizeWInput"
                                ToolTip = "Width"
                                PlaceholderText = "0"
                                Icon = "{u:SymbolIcon Symbol=AutofitWidth24}"
                                MaxDecimalPlaces = "0"
                                MaxLines = "1" />

                            <u:NumberBox
                                Grid.Row = "2"
                                x:Name = "GridSizeHInput"
                                ToolTip = "Height"
                                PlaceholderText = "0"
                                Icon = "{u:SymbolIcon Symbol=AutoFitHeight24}"
                                MaxDecimalPlaces = "0"
                                MaxLines = "1" />


                            <Grid
                                Grid.Row = "3"
                                VerticalAlignment = "Center"
                                HorizontalAlignment = "Center"
                                Margin = "4">
                                <Grid.RowDefinitions>
                                    <RowDefinition
                                        Height = "Auto" />
                                    <RowDefinition
                                        Height = "4" />
                                    <RowDefinition
                                        Height = "Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel
                                    Grid.Row = "0"
                                    Orientation = "Horizontal"
                                    HorizontalAlignment = "Center">

                                    <u:SymbolIcon
                                        Margin = "0,0,6,0"
                                        VerticalAlignment = "Center"
                                        Symbol = "Info24"
                                        FontSize = "14" />

                                    <u:TextBlock
                                        Text = "Configuration"
                                        TextWrapping = "Wrap"
                                        TextTrimming = "CharacterEllipsis"
                                        TextAlignment = "Center"
                                        FontTypography = "BodyStrong" />

                                </StackPanel>

                                <u:TextBlock
                                    Grid.Row = "2"
                                    Text = "Size the grid according to your needs. This grid size will be the same across all 9 pages in the deck and cannot be changed later."
                                    TextWrapping = "Wrap"
                                    TextTrimming = "CharacterEllipsis"
                                    TextAlignment = "Center"
                                    FontTypography = "Caption" />
                            </Grid>
                        </Grid>

                        <u:CardControl
                            Grid.Column = "2"
                            MinHeight = "266"
                            MaxHeight = "266">
                            <u:CardControl.Header>
                                <Grid>
                                    <p:PreviewControl
                                        d:IsHidden = "True"
                                        d:DataContext = "{Binding}"
                                        ViewModel = "{Binding}" />

                                </Grid>
                            </u:CardControl.Header>
                        </u:CardControl>
                    </Grid>
                </u:CardControl.Header>
            </u:CardControl>
        </Grid>
    </u:ContentDialog.Content>
</u:ContentDialog>
