<r:ReactiveUserControl
    x:Name = "Control"
    x:TypeArguments = "l:DeckViewModel"
    x:Class = "Virtuoso.UI.Views.Decks.Components.PagerControl"
    xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c = "http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d = "http://schemas.microsoft.com/expression/blend/2008"
    xmlns:s = "clr-namespace:Lepo.i18n.Wpf;assembly=Lepo.i18n.Wpf"
    xmlns:u = "http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l = "clr-namespace:Virtuoso.UI.Views.Decks"
    xmlns:r = "http://reactiveui.net"
    c:Ignorable = "d">
    <Grid>
        <u:CardControl
            CornerRadius = "24"
            Padding = "12,0">
            <u:CardControl.Header>
                <Menu
                    x:Name = "Paginator"
                    Cursor = "UpArrow" />

            </u:CardControl.Header>
        </u:CardControl>
    </Grid>
</r:ReactiveUserControl>
